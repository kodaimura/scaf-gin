APP_ENV=dev
APP_NAME=scaf-gin
APP_HOST=localhost
APP_PORT=8000

ENABLE_SIGNUP=true
AUTH_LOGIN_ID_MODE=email

DB_ENGINE=postgres
DB_NAME=project_db
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

MAIL_PROVIDER=mailhog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.local

# SMTP example
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@example.com

BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

ACCESS_TOKEN_SECRET=change-me-access-token-secret
ACCESS_TOKEN_EXPIRES_SECONDS=900
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_SECONDS=2592000

COOKIE_ACCESS_SECURE=false
COOKIE_REFRESH_SECURE=false
COOKIE_ACCESS_HTTPONLY=true
COOKIE_REFRESH_HTTPONLY=true

PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_RESEND_INTERVAL_MINUTES=5

LOG_LEVEL=info
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
