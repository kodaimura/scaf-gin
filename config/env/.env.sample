APP_NAME=scaf-gin
APP_HOST=localhost
APP_PORT=8000
ENABLE_SIGNUP=true
AUTH_LOGIN_ID_MODE=email

DB_ENGINE=postgres
DB_NAME=project_db
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

MAIL_PROVIDER=mailhog
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.local

BASIC_AUTH_USER=user
BASIC_AUTH_PASSWORD=pass

ACCESS_TOKEN_SECRET=randomstring
ACCESS_TOKEN_EXPIRES_SECONDS=900

REFRESH_TOKEN_SECRET=randomstring
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_SECONDS=2592000

PASSWORD_RESET_URL_BASE=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PASSWORD_RESET_RESEND_INTERVAL_MINUTES=5

COOKIE_ACCESS_SECURE=true
COOKIE_REFRESH_SECURE=true
COOKIE_ACCESS_HTTPONLY=true
COOKIE_REFRESH_HTTPONLY=true

LOG_LEVEL=DEBUG
FRONTEND_ORIGIN=http://localhost:3000
